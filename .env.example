# Copy to .env (git ignores it) and set a real value for each key.
# The compose file refuses to start while a key is missing.

# Local database passwords: the owner role that migrates, and the
# runtime role that holds data rights only (D-013). Generate each, for
# example: openssl rand -hex 24
POSTGRES_PASSWORD=
MANIFEST_IDENTITY_APP_DB_PASSWORD=

# Only needed when running the application outside docker compose:
# MANIFEST_IDENTITY_DATABASE_URL=postgresql+psycopg://manifest_identity:the-password@localhost:5432/manifest_identity

# Startup creates this administrator if it does not exist; both keys
# must be set together. Leave unset to skip bootstrap.
MANIFEST_IDENTITY_ADMIN_USERNAME=
MANIFEST_IDENTITY_ADMIN_PASSWORD=
